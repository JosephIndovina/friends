{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Friends Live",
  "mainBinaryName": "friends-live",
  "version": "0.1.0",
  "identifier": "dev.indovina.friends.live",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Friends Live",
        "width": 400,
        "height": 600,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Video",
    "shortDescription": "Stream a window and one app's sound to Friends",
    "linux": {
      "deb": {
        "depends": ["libpipewire-0.3-0", "libwebkit2gtk-4.1-0", "xdg-desktop-portal"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["friends"]
      }
    }
  }
}
