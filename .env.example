# Copy to .env and fill in. Never commit .env.
# Public origin the browser uses (dev: the Vite server; prod: https://friends.indovina.dev)
PUBLIC_URL=http://localhost:5173
PORT=3000
DATA_DIR=./data

# Discord application (discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_NOTIFY_CHANNEL_ID=
# Discord user id of the site owner (always has every permission)
OWNER_DISCORD_ID=

# Deployment only (docker-compose)
TUNNEL_TOKEN=
CLOUDFLARE_API_TOKEN=
# NAS only: pull the private image from GHCR (classic PAT, read:packages)
GHCR_USER=
GHCR_TOKEN=

# YouTube Data API v3 key (search + playlists)
YOUTUBE_API_KEY=

# Optional: Twitch app credentials (dev.twitch.tv/console) for VOD/clip titles, thumbnails and durations
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Spotify app (track/album/playlist metadata; playback is matched to YouTube)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# LiveKit (Cast). In production compose sets LIVEKIT_URL; generate a key/secret pair (see README)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
